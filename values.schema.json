{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "scion chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "hub",
    "auth",
    "agents",
    "persistence",
    "database",
    "storage",
    "service",
    "ingress",
    "serviceAccount",
    "rbac",
    "probes",
    "config"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "description": "Hub image built WITH web assets embedded. The published ghcr.io/homebrew-scion/scion-hub is built -tags no_embed_web and serves an empty UI."
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      },
      "required": [
        "repository"
      ]
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hubId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string",
          "pattern": "^https://.+"
        },
        "home": {
          "type": "string",
          "pattern": "^/.+"
        },
        "webPort": {
          "type": "integer",
          "minimum": 1
        },
        "enableWeb": {
          "type": "boolean"
        },
        "webAssetsDir": {
          "type": "string"
        },
        "adminEmails": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "required": [
        "hubId",
        "baseUrl",
        "home",
        "webPort"
      ]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "resourcePolicyKeep": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string",
          "enum": [
            "sqlite"
          ],
          "description": "Only sqlite. postgres makes the hub take an HA code path upstream documents as unlanded."
        },
        "maxOpenConns": {
          "type": "integer",
          "minimum": 1
        },
        "maxIdleConns": {
          "type": "integer",
          "minimum": 1
        },
        "connMaxLifetime": {
          "type": "string"
        },
        "connMaxIdleTime": {
          "type": "string"
        }
      },
      "required": [
        "driver"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "local"
          ]
        }
      },
      "required": [
        "provider"
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "oauth",
            "proxy"
          ]
        },
        "userAccessMode": {
          "type": "string",
          "enum": [
            "invite_only",
            "domain_restricted",
            "open"
          ],
          "description": "Only these three are implemented. Upstream's example documents \"allowlist\", which is not, and silently means open."
        },
        "authorizedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acknowledgeOpenAccess": {
          "type": "boolean"
        },
        "sessionSecret": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "github": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientId": {
                  "type": "string"
                },
                "clientSecret": {
                  "type": "string"
                }
              }
            },
            "google": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientId": {
                  "type": "string"
                },
                "clientSecret": {
                  "type": "string"
                }
              }
            }
          }
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "header": {
              "type": "string"
            },
            "trustedProxies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "mode",
        "userAccessMode"
      ]
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "listAllNamespaces": {
          "type": "boolean"
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "anthropicApiKey": {
              "type": "string"
            },
            "geminiApiKey": {
              "type": "string"
            },
            "openaiApiKey": {
              "type": "string"
            },
            "extra": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "create"
          ]
        }
      },
      "required": [
        "imageRegistry",
        "credentials"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "create"
      ]
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      },
      "required": [
        "create"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "port"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pathType": {
          "type": "string",
          "enum": [
            "Prefix",
            "Exact",
            "ImplementationSpecific"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      "required": [
        "enabled"
      ]
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "description": "Path all probes query. /readyz is the only endpoint that can fail; /healthz always returns 200."
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "containerSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extra": {
          "type": "object"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    }
  }
}
